{
  "id": "ark-survival-ascended",
  "name": "ARK: Survival Ascended",
  "description": "Next-generation dinosaur survival game with Unreal Engine 5 worlds and CurseForge mods.",
  "icon": "ark-survival-ascended",
  "available": true,
  "docker_image": "johnnyknighten/ark-sa-server",
  "default_tag": "2.2.2",
  "ports": [
    {
      "container_port": 7777,
      "default_host_port": 7777,
      "protocol": "udp",
      "label": "Game Port"
    },
    {
      "container_port": 7778,
      "default_host_port": 7778,
      "protocol": "udp",
      "label": "Additional Game Port"
    },
    {
      "container_port": 27015,
      "default_host_port": 27015,
      "protocol": "udp",
      "label": "Query Port"
    },
    {
      "container_port": 27020,
      "default_host_port": 27020,
      "protocol": "tcp",
      "label": "RCON Port",
      "role": "rcon"
    }
  ],
  "environment": [
    {
      "key": "SERVER_NAME",
      "default_value": "Cubelit-ASA-Server",
      "label": "Server Name",
      "type": "string",
      "options": []
    },
    {
      "key": "MAP",
      "default_value": "TheIsland_WP",
      "label": "Map",
      "type": "select",
      "options": [
        "TheIsland_WP",
        "ScorchedEarth_WP",
        "TheCenter_WP",
        "Aberration_WP",
        "Extinction_WP",
        "Astraeos_WP",
        "Ragnarok_WP"
      ]
    },
    {
      "key": "MAX_PLAYERS",
      "default_value": "20",
      "label": "Max Players",
      "type": "number",
      "options": []
    },
    {
      "key": "SERVER_PASSWORD",
      "default_value": "",
      "label": "Server Password",
      "type": "string",
      "options": []
    },
    {
      "key": "ADMIN_PASSWORD",
      "default_value": "changeme",
      "label": "Admin Password / RCON Password",
      "type": "string",
      "options": []
    },
    {
      "key": "MOD_LIST",
      "default_value": "",
      "label": "Mod IDs (comma-separated)",
      "type": "string",
      "options": []
    },
    {
      "key": "ENABLE_PVE",
      "default_value": "False",
      "label": "PvE Mode",
      "type": "boolean",
      "options": []
    },
    {
      "key": "NO_BATTLEYE",
      "default_value": "True",
      "label": "Disable BattlEye",
      "type": "boolean",
      "options": []
    },
    {
      "key": "ENABLE_RCON",
      "default_value": "True",
      "label": "Enable RCON",
      "type": "boolean",
      "options": []
    },
    {
      "key": "MANUAL_CONFIG",
      "default_value": "False",
      "label": "Manual Config Files",
      "type": "boolean",
      "options": []
    },
    {
      "key": "GAME_PORT",
      "default_value": "7777",
      "label": "Game Port Inside Container",
      "type": "number",
      "options": []
    },
    {
      "key": "QUERY_PORT",
      "default_value": "27015",
      "label": "Query Port Inside Container",
      "type": "number",
      "options": []
    },
    {
      "key": "RCON_PORT",
      "default_value": "27020",
      "label": "RCON Port Inside Container",
      "type": "number",
      "options": []
    }
  ],
  "volumes": [
    {
      "container_path": "/ark-server/server",
      "label": "Server Data"
    },
    {
      "container_path": "/ark-server/logs",
      "label": "Logs"
    },
    {
      "container_path": "/ark-server/backups",
      "label": "Backups"
    }
  ],
  "config_files": [
    {
      "path": "ShooterGame/Saved/Config/WindowsServer/GameUserSettings.ini",
      "format": "ini",
      "label": "Server Settings",
      "fields": [
        {
          "key": "SessionName",
          "label": "Server name",
          "type": "string",
          "section": "[SessionSettings]",
          "default": "Cubelit-ASA-Server"
        },
        {
          "key": "MaxPlayers",
          "label": "Max players",
          "type": "number",
          "section": "[/Script/Engine.GameSession]",
          "min": 1,
          "max": 200,
          "default": "20"
        },
        {
          "key": "ServerPVE",
          "label": "PVE server",
          "type": "boolean",
          "section": "[ServerSettings]",
          "default": "False"
        },
        {
          "key": "XPMultiplier",
          "label": "XP multiplier",
          "type": "number",
          "section": "[ServerSettings]",
          "min": 0.1,
          "max": 10,
          "step": 0.1,
          "default": "1"
        },
        {
          "key": "TamingSpeedMultiplier",
          "label": "Taming speed",
          "type": "number",
          "section": "[ServerSettings]",
          "min": 1,
          "max": 5000,
          "step": 1,
          "default": "1"
        },
        {
          "key": "HarvestAmountMultiplier",
          "label": "Harvest amount",
          "type": "number",
          "section": "[ServerSettings]",
          "min": 0.5,
          "max": 20,
          "step": 0.5,
          "default": "1"
        },
        {
          "key": "PlayerCharacterWaterDrainMultiplier",
          "label": "Water drain",
          "type": "number",
          "section": "[ServerSettings]",
          "min": 0,
          "max": 5,
          "step": 0.1,
          "default": "1"
        },
        {
          "key": "PlayerCharacterFoodDrainMultiplier",
          "label": "Food drain",
          "type": "number",
          "section": "[ServerSettings]",
          "min": 0,
          "max": 5,
          "step": 0.1,
          "default": "1"
        }
      ]
    }
  ],
  "dashboard": {
    "command": {
      "mode": "source_rcon",
      "port_role": "rcon",
      "password_env": "ADMIN_PASSWORD",
      "password_default": "changeme",
      "probe": "listplayers",
      "quick_commands": [
        {
          "label": "List players",
          "command": "listplayers"
        },
        {
          "label": "Save world",
          "command": "saveworld"
        }
      ]
    },
    "file_tabs": [
      {
        "path": "ShooterGame/Binaries/Win64/ShooterGame/Mods",
        "label": "Mods",
        "upload": true
      }
    ]
  },
  "mods": {
    "supported": true,
    "path": "ShooterGame/Binaries/Win64/ShooterGame/Mods",
    "file_types": []
  },
  "estimated_disk_mb": 100000,
  "tags": [
    "survival",
    "dinosaurs",
    "moddable"
  ],
  "readiness": {
    "log_pattern": "Server has completed startup and is now advertising for join",
    "timeout_secs": 3600
  }
}
