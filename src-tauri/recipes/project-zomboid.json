{
  "id": "project-zomboid",
  "name": "Project Zomboid",
  "description": "Open-world zombie survival with deep crafting and building mechanics.",
  "icon": "project-zomboid",
  "available": true,
  "docker_image": "indifferentbroccoli/projectzomboid-server-docker",
  "default_tag": "v1.1.6",
  "ports": [
    {
      "container_port": 16261,
      "default_host_port": 16261,
      "protocol": "udp",
      "label": "Game Port"
    },
    {
      "container_port": 16262,
      "default_host_port": 16262,
      "protocol": "udp",
      "label": "Direct Connect Port"
    }
  ],
  "environment": [
    {
      "key": "PUID",
      "default_value": "1000",
      "label": "PUID (user ID for file permissions)",
      "type": "string",
      "options": []
    },
    {
      "key": "PGID",
      "default_value": "1000",
      "label": "PGID (group ID for file permissions)",
      "type": "string",
      "options": []
    },
    {
      "key": "SERVER_NAME",
      "default_value": "CubelitPZ",
      "label": "Server Name",
      "type": "string",
      "options": []
    },
    {
      "key": "MAX_PLAYERS",
      "default_value": "16",
      "label": "Max Players",
      "type": "number",
      "options": []
    },
    {
      "key": "ADMIN_USERNAME",
      "default_value": "admin",
      "label": "Admin Username",
      "type": "string",
      "options": []
    },
    {
      "key": "ADMIN_PASSWORD",
      "default_value": "changeme",
      "label": "Admin Password",
      "type": "string",
      "options": []
    },
    {
      "key": "PASSWORD",
      "default_value": "",
      "label": "Server Password",
      "type": "string",
      "options": []
    }
  ],
  "volumes": [
    {
      "container_path": "/project-zomboid",
      "label": "Server Files"
    },
    {
      "container_path": "/project-zomboid-config",
      "label": "Server Config"
    }
  ],
  "config_files": [],
  "mods": {
    "supported": true,
    "path": "Workshop",
    "file_types": []
  },
  "estimated_disk_mb": 5000,
  "tags": ["survival", "zombie", "moddable"],
  "readiness": {
    "log_pattern": "*** SERVER STARTED ****",
    "timeout_secs": 600
  }
}
