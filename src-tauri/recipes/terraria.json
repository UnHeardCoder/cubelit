{
  "id": "terraria",
  "name": "Terraria",
  "description": "2D sandbox adventure game. Uses TShock server. On first launch, a new world is auto-created.",
  "icon": "terraria",
  "available": true,
  "docker_image": "ryshe/terraria",
  "default_tag": "tshock-1.4.4.9-5.2.4",
  "server_cmd": ["-autocreate", "2", "-worldname", "CubelitWorld"],
  "ports": [
    {
      "container_port": 7777,
      "default_host_port": 7777,
      "protocol": "tcp",
      "label": "Game Port"
    }
  ],
  "environment": [
    {
      "key": "WORLD_FILENAME",
      "default_value": "CubelitWorld.wld",
      "label": "World Filename (the in-game world name is always 'CubelitWorld')",
      "type": "string",
      "options": []
    },
    {
      "key": "MAX_PLAYERS",
      "default_value": "8",
      "label": "Max Players",
      "type": "number",
      "options": []
    },
    {
      "key": "DIFFICULTY",
      "default_value": "1",
      "label": "Difficulty (0=classic 1=expert 2=master 3=journey)",
      "type": "select",
      "options": ["0", "1", "2", "3"]
    }
  ],
  "volumes": [
    {
      "container_path": "/root/.local/share/Terraria/Worlds",
      "label": "World Data"
    }
  ],
  "config_files": [],
  "mods": {
    "supported": true,
    "path": "ServerPlugins",
    "file_types": [".dll"]
  },
  "estimated_disk_mb": 1000,
  "tags": ["sandbox", "moddable"],
  "readiness": {
    "log_pattern": "Server started",
    "timeout_secs": 300
  }
}
